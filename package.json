{
  "name": "tnec-placement-test",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TNEC placement test (apps/web) and internal dashboard (apps/admin) on Node.js with Neon PostgreSQL.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=21.7"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:web": "npm run start -w @tnec/web",
    "start:admin": "npm run start -w @tnec/admin",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "node tests/smoke.mjs"
  }
}
