# Copy to .env and fill in. .env is never committed.

# Neon PostgreSQL connection string (pooled host, sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Ports and public addresses. Test links sent from the dashboard use PUBLIC_WEB_URL.
WEB_PORT=4000
ADMIN_PORT=4001
PUBLIC_WEB_URL=http://localhost:4000
ADMIN_URL=http://localhost:4001
# Set to 1 when the apps run behind a reverse proxy that sets X-Forwarded-Proto and X-Forwarded-Host.
TRUST_PROXY=0
# A host that sets PORT (Render, for example) gives that port to an app started on its own,
# in place of WEB_PORT or ADMIN_PORT.

# Optional fixed setup code (at least 8 characters) for the first admin account on a host that
# restarts the app often, such as Render. Without it, every start prints a new random code.
ADMIN_SETUP_CODE=

# Result emails through the Cloudflare Email Sending API. Leave empty to skip emails.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
RESULT_FROM_EMAIL=Titik Nol English Course <placement@index-now.dev>

# WhatsApp through AttCos
ATTCOS_API_BASE=https://csq-api.onrender.com/api/v1
ATTCOS_CHANNEL_ID=6a94705f-8df3-47e7-9262-639637209fc5
ATTCOS_API_KEY=
